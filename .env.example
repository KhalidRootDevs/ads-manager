# Local development secrets. Never commit this file.
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
# Orbit uses its own database on the shared dev cluster. Other databases on the cluster are never touched.
MONGODB_DB=orbit_ads_dev
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
# Creative storage: 'local' writes to ./.data/uploads and the API serves it; 's3' uses S3_BUCKET_CREATIVES + CDN_BASE_URL.
STORAGE_DRIVER=local
CDN_BASE_URL=http://localhost:4000/media
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
KEY_PEPPER=dev-key-pepper-change-me-0123456789abcdef
TRACKING_SECRETS=k1:dev-tracking-secret-change-me-0123456789
TRACKING_ACTIVE_KID=k1
AUTH_DEV_LOGIN=true
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
AD_SERVER_URL=http://localhost:4100
TRACKING_URL=http://localhost:4200
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AD_SERVER_URL=http://localhost:4100
INTERNAL_TOKEN=dev-internal-token-change-me-0123456789
UID_PEPPER=dev-uid-pepper-change-me-0123456789
# 1.0 in development so every request shows up in Diagnostics; 0.01 in production (§6.5 request_samples)
REQUEST_SAMPLE_RATE=1
# Fallback country when no GeoIP database is configured (development only)
DEV_DEFAULT_COUNTRY=BD
GEOIP_DB_PATH=
API_PORT=4000
AD_SERVER_PORT=4100
COLLECTOR_PORT=4200
WORKERS_PORT=4300
