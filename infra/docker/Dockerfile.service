# Build one Node service from the monorepo:
#   docker build -f infra/docker/Dockerfile.service --build-arg APP=api -t orbit-api .
# APP ∈ api | ad-server | collector | workers. Workspace packages are bundled by tsup (noExternal @orbit/*).
FROM node:22-alpine AS build
ARG APP
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter "@orbit/${APP}..." build
RUN pnpm --filter "@orbit/${APP}" deploy --prod --legacy /out

FROM node:22-alpine
ARG APP
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/ ./
# The ad server serves the web tag bundle.
COPY --from=build /repo/packages/sdk-web/dist /packages/sdk-web/dist
USER node
EXPOSE 4000 4100 4200 4300
CMD ["node", "--enable-source-maps", "dist/index.js"]
