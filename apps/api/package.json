{
  "name": "@orbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@orbit/db": "workspace:*",
    "@orbit/domain": "workspace:*",
    "@orbit/server-kit": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^5.8.0",
    "mongoose": "^9.11.2",
    "openid-client": "^6.8.8",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.3.0",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.0"
  }
}
