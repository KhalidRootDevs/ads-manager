{
  "name": "@orbit/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts all",
    "dev:compiler": "tsx watch --env-file-if-exists=../../.env src/index.ts compiler",
    "dev:aggregator": "tsx watch --env-file-if-exists=../../.env src/index.ts aggregator",
    "dev:jobs": "tsx watch --env-file-if-exists=../../.env src/index.ts jobs",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "tsx --env-file=../../.env scripts/e2e.ts",
    "jobs:run": "tsx --env-file-if-exists=../../.env src/index.ts jobs --run"
  },
  "dependencies": {
    "@orbit/db": "workspace:*",
    "@orbit/domain": "workspace:*",
    "@orbit/server-kit": "workspace:*",
    "ioredis": "^5.8.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.11.2",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "tsup": "^8.5.0"
  }
}
